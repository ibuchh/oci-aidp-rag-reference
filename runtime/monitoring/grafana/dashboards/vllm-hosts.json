    },
    {
      "id": 9,
      "title": "Disk throughput",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(node_disk_read_bytes_total{instance=~\"$node\",device!~\"loop.*\"}[$__rate_interval]))",
          "legendFormat": "read {{device}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (device) (rate(node_disk_written_bytes_total{instance=~\"$node\",device!~\"loop.*\"}[$__rate_interval]))",
          "legendFormat": "written {{device}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
