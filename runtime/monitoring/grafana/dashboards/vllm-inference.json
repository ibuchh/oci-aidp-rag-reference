{
  "uid": "vllm-inference",
  "title": "vLLM - Inference",
  "description": "Server metrics plus a five-minute private HTTPS authenticated probe. Synthetic requests are included in vLLM totals. Percentiles are undefined until requests arrive. These are baselines, not SLO thresholds.",
  "tags": [
    "OCI",
    "vLLM",
    "vllm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "uid": "prometheus",
          "type": "prometheus"
        },
        "query": "label_values(vllm:num_requests_running, model_name)",
        "refresh": 1,
        "current": {
          "text": "qwen3-8b",
          "value": "qwen3-8b"
        }
      }
    ]
  },
  "links": [
    {
      "title": "Inference",
      "type": "link",
      "url": "/d/vllm-inference",
      "targetBlank": false
    },
    {
      "title": "GPUs",
      "type": "link",
      "url": "/d/vllm-gpus",
      "targetBlank": false
    },
    {
      "title": "Hosts",
      "type": "link",
      "url": "/d/vllm-hosts",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "vLLM metrics reachable",
      "type": "stat",
      "description": "Scrape success only; does not prove inference works.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"vllm\"}",
          "legendFormat": "vLLM metrics reachable",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Last authenticated inference probe",
      "type": "stat",
      "description": "1 = succeeded, 0 = failed. See probe age; interval five minutes.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_probe_success",
          "legendFormat": "Last authenticated inference probe",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Probe age",
      "type": "stat",
      "description": "A stale probe can retain its last success. Expected less than 360 seconds while monitoring is healthy.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - inference_probe_timestamp_seconds",
          "legendFormat": "Probe age",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
