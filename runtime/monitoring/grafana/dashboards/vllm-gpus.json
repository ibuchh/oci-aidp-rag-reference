{
  "uid": "vllm-gpus",
  "title": "vLLM - GPUs",
  "description": "DCGM Exporter 4.9.0 with the existing DCGM 4.7.0 host engine. Each series represents one physical A10; model metrics are not duplicated per GPU.",
  "tags": [
    "OCI",
    "vLLM",
    "vllm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Inference",
      "type": "link",
      "url": "/d/vllm-inference",
      "targetBlank": false
    },
    {
      "title": "GPUs",
      "type": "link",
      "url": "/d/vllm-gpus",
      "targetBlank": false
    },
    {
      "title": "Hosts",
      "type": "link",
      "url": "/d/vllm-hosts",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "DCGM scrape reachable",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"dcgm\"}",
          "legendFormat": "DCGM scrape reachable",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "GPUs reporting memory",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(DCGM_FI_DEV_FB_USED_BYTES)",
          "legendFormat": "GPUs reporting memory",
          "range": true
