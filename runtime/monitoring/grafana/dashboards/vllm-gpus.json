        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(DCGM_EXP_XID_ERRORS_TOTAL) or vector(0)",
          "legendFormat": "Last XID code (maximum across GPUs)",
          "range": true
